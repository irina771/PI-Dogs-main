:"51","usedDeprecatedRules":"38"},{"filePath":"52","messages":"53","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"54","messages":"55","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"56","messages":"57","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"58","usedDeprecatedRules":"38"},{"filePath":"59","messages":"60","errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"61","usedDeprecatedRules":"38"},{"filePath":"62","messages":"63","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"64","messages":"65","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"66","messages":"67","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"68","messages":"69","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"70","usedDeprecatedRules":"38"},{"filePath":"71","messages":"72","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},{"filePath":"73","messages":"74","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"38"},"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\index.js",[],["75","76"],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\App.js",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\reportWebVitals.js",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\views\\index.js",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\views\\CreateDog.jsx",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\views\\DetailPage.jsx",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\views\\HomePage.jsx",["77"],"import React from \"react\";\r\nimport { useState, useEffect } from \"react\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { getDogs, getTemperaments, clean } from \"../redux/actions/index\";\r\nimport { Link } from \"react-router-dom\";\r\nimport Card from \"../components/Card\";\r\nimport Pagination from \"../components/Pagination\";\r\nimport Filter2 from \"../components/Filter2\";\r\nimport Filter1 from \"../components/Filter1\";\r\nimport Filter3 from \"../components/Filter3\";\r\nimport styles from \"../styles/Home.module.css\";\r\nimport SearchBar from \"../components/SearchBar\";\r\n\r\nconst HomePage = () => {\r\n  const dispatch = useDispatch();\r\n\r\n  //para manipular los states\r\n  const allDog = useSelector((state) => state.dogs);\r\n\r\n  // Creamos un state con la pagina actual y otro que haga set\r\n  const [currentPage, setCurrentPage] = useState(1);\r\n  const [DogPerPage, setDogPerPage] = useState(8); //asi mostramos 8 por pagina\r\n  const indexLastDog = currentPage * DogPerPage;\r\n  const indexFirstDog = indexLastDog - DogPerPage;\r\n  //para marcar la distancia el slice parte a la mitad.\r\n  const currentDog = allDog.slice(indexFirstDog, indexLastDog);\r\n  //para setear la pagina en ese numero de pagina. Helps with rendering\r\n  const paging = (pageNumber) => {\r\n    setCurrentPage(pageNumber);\r\n  };\r\n\r\n  function handleClick(e) {\r\n    e.preventDefault(); // para que no se rompa. Just in case.\r\n    dispatch(getDogs());\r\n    setCurrentPage(1);\r\n  }\r\n  // se va a ejecutar cada vez que ocurra dispatch como en el did mount >// vacio no depende de nada\r\n  useEffect(() => {\r\n    console.log(\"Fetching dogs...\");\r\n    dispatch(getDogs());\r\n    console.log(\"Fetching temperaments...\");\r\n    dispatch(getTemperaments());\r\n    console.log(\"Cleaning state...\");\r\n    dispatch(clean());\r\n  }, [dispatch]);\r\n\r\n  \r\n\r\n  return (\r\n    <div className={styles.background}>\r\n      <nav className={styles.nav}>\r\n        <div>\r\n          <SearchBar setCurrentPage={setCurrentPage}/>\r\n          <Link to=\"/createDog\">\r\n            <button className={styles.btn}>Crear Perrito</button>\r\n          </Link>\r\n           <button \r\n          onClick={(e) => {\r\n            handleClick(e);\r\n          }}\r\n          className={`${styles.btn} ${styles.recarga}`}\r\n        >\r\n          Home\r\n        </button>\r\n        </div>\r\n        <div>\r\n          <Filter2 setCurrentPage={setCurrentPage} />\r\n          <Filter1 setCurrentPage={setCurrentPage} />\r\n          <Filter3 setCurrentPage={setCurrentPage} />\r\n        </div>\r\n      </nav>\r\n\r\n      {/* cambiamos a current */}\r\n      <div className={`${styles.card} ${styles.cardContainer}`}>\r\n        {/* cambiamos al current para que aparezcan los que quiero */}\r\n        {currentDog.length === 0 ? (\r\n          <img className={styles.image} alt=\"No hay perritos\"></img>\r\n        ) : (\r\n          currentDog.map((c) => {\r\n            return (\r\n              <div className={styles.cardFormat} key={c.id}>\r\n                <Link className={styles.name} to={\"/dogs/\" + c.id}>\r\n                  <Card\r\n                    name={c.name}\r\n                    image={c.image}\r\n                    weight={c.weight}\r\n                    temperament={c.temperaments}\r\n                  />\r\n                </Link>\r\n              </div>\r\n            );\r\n          })\r\n        )}\r\n      </div>\r\n        <div className={styles.paginationContainer}>\r\n      <div className={styles.pagination}>\r\n        <Pagination\r\n          DogPerPage={DogPerPage}\r\n          allDog={allDog.length}\r\n          paging={paging}\r\n        />\r\n      </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default HomePage;\r\n","C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\views\\LandingPage.jsx",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\redux\\actions\\index.js",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\components\\Card.jsx",["78"],"import React from \"react\";\r\nimport styles from \"../styles/cardComponent.css\";\r\n\r\nexport default function Card({ name, image, temperament, weight }) {\r\n  console.log(image);\r\n  return (\r\n    <div>\r\n      <div className={`homeCard`}>\r\n        <div className={`card-text`}>\r\n          <div className={`letraTitulo`}>\r\n            <h3>{name}</h3>\r\n          </div>\r\n          <div>\r\n          <img src={image} alt=\"img\" />\r\n          </div>\r\n          <div className={`letra`}>\r\n          <h4>Peso min y max: </h4>\r\n          <p>{weight}</p>\r\n          <h4>Temperamentos:</h4>\r\n          <p> {temperament.join(\", \")}</p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\components\\SearchBar.jsx",["79","80"],"import React, { useState } from \"react\";\r\nimport { useDispatch, useSelector } from \"react-redux\";\r\nimport { getByName } from \"../redux/actions/index\";\r\nimport { useHistory } from \"react-router-dom\";\r\nimport styles from '../styles/SearchBar.module.css'\r\n\r\nexport default function SearchBar({setCurrentPage}) {\r\n  const dispatch = useDispatch();\r\n  const history = useHistory();\r\n  const [name, setName] = useState(\"\");\r\n  const [dogData, setDogData] = useState(null);\r\n\r\n  function handleInputChange(e) {\r\n    setName(e.target.value);\r\n  }\r\n\r\n  function handleSubmit(e) {\r\n    e.preventDefault();\r\n    if (name) {\r\n      dispatch(getByName(name));\r\n      setName(\"\");\r\n      setCurrentPage(1);\r\n    }\r\n  }\r\n\r\n  return (\r\n    <div className={styles.searchBar}>\r\n      <form onSubmit={handleSubmit}>\r\n        <input\r\n         \r\n          type=\"text\"\r\n          placeholder=\"Busca Perritos\"\r\n          value={name}\r\n          onChange={handleInputChange}\r\n        />\r\n        <button  type=\"submit\">🔍</button>\r\n      </form>\r\n      {dogData !== null && dogData.id && history.push(`/dogs/:${dogData.id}`)}\r\n    </div>\r\n  );\r\n}\r\n","C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\components\\Pagination.jsx",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\redux\\store\\index.js",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\redux\\reducers\\index.js",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\components\\Filter1.jsx",["81"],"import { useDispatch } from \"react-redux\";\r\nimport { orderBy } from \"../redux/actions/index\";\r\nimport { useState } from \"react\";\r\nimport styles from \"../styles/filters.module.css\";\r\n\r\nfunction Filter1({ setCurrentPage }) {\r\n  const dispatch = useDispatch();\r\n  const [state, setState] = useState(\"\");\r\n\r\n  const handleSort = (e) => {\r\n    e.preventDefault();\r\n    dispatch(orderBy(e.target.value));\r\n    setState(e.target.value);\r\n    setCurrentPage(1);\r\n  };\r\n\r\n  return (\r\n    <div className={styles.filterContainer}>\r\n      <div >\r\n        <select className={styles.filter} onChange={(e) => handleSort(e)}>\r\n          <option value=\"ascendente\">A-Z</option>\r\n          <option value=\"descendente\">Z-A</option>\r\n          <option value=\"mayor\">+ Peso</option>\r\n          <option value=\"menor\">- Peso</option>\r\n        </select>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\nexport default Filter1;\r\n","C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\components\\Filter2.jsx",[],"C:\\Users\\irina\\OneDrive\\Escritorio\\henry\\PI-Dogs-main\\client\\src\\components\\Filter3.jsx",[],{"ruleId":"82","replacedBy":"83"},{"ruleId":"84","replacedBy":"85"},{"ruleId":"86","severity":1,"message":"87","line":22,"column":22,"nodeType":"88","messageId":"89","endLine":22,"endColumn":35},{"ruleId":"86","severity":1,"message":"90","line":2,"column":8,"nodeType":"88","messageId":"89","endLine":2,"endColumn":14},{"ruleId":"86","severity":1,"message":"91","line":2,"column":23,"nodeType":"88","messageId":"89","endLine":2,"endColumn":34},{"ruleId":"86","severity":1,"message":"92","line":11,"column":19,"nodeType":"88","messageId":"89","endLine":11,"endColumn":29},{"ruleId":"86","severity":1,"message":"93","line":8,"column":10,"nodeType":"88","messageId":"89","endLine":8,"endColumn":15},"no-native-reassign",["94"],"no-negated-in-lhs",["95"],"no-unused-vars","'setDogPerPage' is assigned a value but never used.","Identifier","unusedVar","'styles' is defined but never used.","'useSelector' is defined but never used.","'setDogData' is assigned a value but never used.","'state' is assigned a value but never used.","no-global-assign","no-unsafe-negation"]